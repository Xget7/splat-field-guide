# Resolve through Node so hoisted React Native installations work.
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

# Apple Foundation Models require iOS 26 or later.
IOS_DEPLOYMENT_TARGET = '26.0'
platform :ios, IOS_DEPLOYMENT_TARGET
prepare_react_native_project!

# Verify pinned resources before CocoaPods enumerates them.
unless system('python3', File.expand_path('../scripts/fetch-kokoro-models.py', __dir__))
  raise 'Kokoro resources could not be verified; see scripts/fetch-kokoro-models.py'
end

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'FieldGuide' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
    )

    # Xcode 27's Metal toolchain lacks the back-deployment Swift library path added by CocoaPods.
    toolchain_swift = '"${TOOLCHAIN_DIR}/usr/lib/swift/${PLATFORM_NAME}"'
    installer.aggregate_targets.each do |target|
      target.xcconfigs.each do |name, xcconfig|
        paths = xcconfig.attributes['LIBRARY_SEARCH_PATHS']
        next unless paths&.include?(toolchain_swift)
        xcconfig.attributes['LIBRARY_SEARCH_PATHS'] = paths.sub(toolchain_swift, '').squeeze(' ')
        xcconfig.save_as(target.xcconfig_path(name))
      end
    end

    # Hermes selects its engine per configuration, so the replacement phase must run on every build.
    installer.pods_project.targets.each do |target|
      target.shell_script_build_phases.each do |phase|
        phase.always_out_of_date = '1' if phase.name&.include?('Replace Hermes')
      end
    end

    # Codegen and Nitro produce empty objects, which trigger libtool warnings.
    # Keep warnings visible for owned native pods while suppressing third-party warnings.
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |build|
        build.build_settings['OTHER_LIBTOOLFLAGS'] = '$(inherited) -no_warning_for_no_symbols'
        next if ['ReactNativeSplat', 'ReactNativeOnDevice'].include?(target.name)
        build.build_settings['GCC_WARN_INHIBIT_ALL_WARNINGS'] = 'YES'
      end
    end

    # Raise legacy pod targets such as AsyncStorage's iOS 13 bundle to the app's supported minimum.
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |build|
        deployment = build.build_settings['IPHONEOS_DEPLOYMENT_TARGET']
        next if deployment.nil? ||
          Gem::Version.new(deployment) >= Gem::Version.new(IOS_DEPLOYMENT_TARGET)
        build.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = IOS_DEPLOYMENT_TARGET
      end
    end
  end
end
