# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

# The on-device instructor uses Apple Foundation Models.
IOS_DEPLOYMENT_TARGET = '26.0'
platform :ios, IOS_DEPLOYMENT_TARGET
prepare_react_native_project!

# Build-time only: pinned and hash-checked resources must exist before CocoaPods enumerates them.
unless system('python3', File.expand_path('../scripts/fetch-kokoro-models.py', __dir__))
  raise 'Kokoro resources could not be verified; see scripts/fetch-kokoro-models.py'
end

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'FieldGuide' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # Swift pods add the toolchain's Swift libraries, which back-deployed Swift before iOS 12.2,
    # to the app's search paths; Xcode 27 resolves the toolchain to the Metal one, which has no
    # such folder, so ld warned about it on every link.
    toolchain_swift = '"${TOOLCHAIN_DIR}/usr/lib/swift/${PLATFORM_NAME}"'
    installer.aggregate_targets.each do |target|
      target.xcconfigs.each do |name, xcconfig|
        paths = xcconfig.attributes['LIBRARY_SEARCH_PATHS']
        next unless paths&.include?(toolchain_swift)
        xcconfig.attributes['LIBRARY_SEARCH_PATHS'] = paths.sub(toolchain_swift, '').squeeze(' ')
        xcconfig.save_as(target.xcconfig_path(name))
      end
    end

    # Hermes' replace script picks the engine for the configuration, so it has to run on every
    # build; saying so keeps Xcode from warning that it declares no outputs.
    installer.pods_project.targets.each do |target|
      target.shell_script_build_phases.each do |phase|
        phase.always_out_of_date = '1' if phase.name&.include?('Replace Hermes')
      end
    end

    # Third party pods warn about their own code; our native pods keep their warnings visible.
    # Codegen and Nitro archive generated files that are empty in the new architecture,
    # which libtool would report on every build.
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |build|
        build.build_settings['OTHER_LIBTOOLFLAGS'] = '$(inherited) -no_warning_for_no_symbols'
        next if ['ReactNativeSplat', 'ReactNativeOnDevice'].include?(target.name)
        build.build_settings['GCC_WARN_INHIBIT_ALL_WARNINGS'] = 'YES'
      end
    end

    # AsyncStorage's resource bundle target asks for iOS 13, below what Xcode 27 can build for;
    # no pod needs less than the app itself.
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |build|
        deployment = build.build_settings['IPHONEOS_DEPLOYMENT_TARGET']
        next if deployment.nil? ||
          Gem::Version.new(deployment) >= Gem::Version.new(IOS_DEPLOYMENT_TARGET)
        build.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = IOS_DEPLOYMENT_TARGET
      end
    end
  end
end
