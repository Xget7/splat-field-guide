{
  "name": "react-native-on-device",
  "version": "0.0.1",
  "description": "ExecuTorch local speech and generation, shared conversation audio, and Nitro network monitoring",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "react-native": "src/index.ts",
  "files": [
    "src",
    "ios",
    "LICENSES",
    "nitrogen",
    "nitro.json",
    "ReactNativeOnDevice.podspec",
    "android",
    "react-native.config.js"
  ],
  "scripts": {
    "codegen": "nitrogen",
    "lint": "eslint . && prettier --check src",
    "typecheck": "tsc --noEmit",
    "test": "jest"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*",
    "react-native-nitro-modules": "^0.37.1"
  },
  "devDependencies": {
    "@react-native/eslint-config": "0.87.1",
    "@react-native/typescript-config": "0.87.1",
    "@types/react": "^19.2.0",
    "eslint": "^8.19.0",
    "jest": "^29.7.0",
    "nitrogen": "^0.37.1",
    "prettier": "2.8.8",
    "react": "19.2.3",
    "react-native": "0.87.1",
    "react-native-nitro-modules": "^0.37.1",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "base64-js": "1.5.1",
    "react-native-audio-api": "1.0.0",
    "react-native-blob-util": "0.24.11",
    "react-native-executorch": "0.11.0"
  },
  "react-native-executorch": {
    "backends": [
      "xnnpack"
    ],
    "libs": [
      "phonemis"
    ]
  }
}
