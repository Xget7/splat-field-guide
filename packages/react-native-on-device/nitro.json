{
  "$schema": "https://nitro.margelo.com/nitro.schema.json",
  "cxxNamespace": [
    "ondevice"
  ],
  "ios": {
    "iosModuleName": "ReactNativeOnDevice"
  },
  "android": {
    "androidNamespace": [
      "ondevice"
    ],
    "androidCxxLibName": "reactnativeondevice"
  },
  "autolinking": {
    "SpeechInput": {
      "ios": {
        "language": "swift",
        "implementationClassName": "HybridSpeechInput"
      },
      "android": {
        "language": "kotlin",
        "implementationClassName": "HybridSpeechInput"
      }
    },
    "SpeechOutput": {
      "ios": {
        "language": "swift",
        "implementationClassName": "HybridSpeechOutput"
      },
      "android": {
        "language": "kotlin",
        "implementationClassName": "HybridSpeechOutput"
      }
    },
    "LanguageModel": {
      "ios": {
        "language": "swift",
        "implementationClassName": "HybridLanguageModel"
      },
      "android": {
        "language": "kotlin",
        "implementationClassName": "HybridLanguageModel"
      }
    },
    "NetworkMonitor": {
      "ios": {
        "language": "swift",
        "implementationClassName": "HybridNetworkMonitor"
      },
      "android": {
        "language": "kotlin",
        "implementationClassName": "HybridNetworkMonitor"
      }
    },
    "AudioLink": {
      "ios": {
        "language": "swift",
        "implementationClassName": "HybridAudioLink"
      },
      "android": {
        "language": "kotlin",
        "implementationClassName": "HybridAudioLink"
      }
    }
  },
  "ignorePaths": [
    "node_modules"
  ]
}
