{
  "$schema": "https://nitro.margelo.com/nitro.schema.json",
  "cxxNamespace": [
    "splat"
  ],
  "ios": {
    "iosModuleName": "ReactNativeSplat"
  },
  "android": {
    "androidNamespace": [
      "splat"
    ],
    "androidCxxLibName": "reactnativesplat"
  },
  "autolinking": {
    "SplatView": {
      "ios": {
        "language": "swift",
        "implementationClassName": "HybridSplatView"
      },
      "android": {
        "language": "kotlin",
        "implementationClassName": "HybridSplatView"
      }
    },
    "SplatDiagnostics": {
      "ios": {
        "language": "swift",
        "implementationClassName": "HybridSplatDiagnostics"
      }
    },
    "BundledPacks": {
      "ios": {
        "language": "swift",
        "implementationClassName": "HybridBundledPacks"
      },
      "android": {
        "language": "kotlin",
        "implementationClassName": "HybridBundledPacks"
      }
    },
    "WorldRetirement": {
      "ios": {
        "language": "swift",
        "implementationClassName": "HybridWorldRetirement"
      },
      "android": {
        "language": "kotlin",
        "implementationClassName": "HybridWorldRetirement"
      }
    }
  },
  "ignorePaths": [
    "node_modules",
    "engine"
  ]
}
