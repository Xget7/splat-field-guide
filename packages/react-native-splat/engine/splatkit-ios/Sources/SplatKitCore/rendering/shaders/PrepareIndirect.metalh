#pragma once
#include "SplatTypes.metalh"

constant uint kDrawBatches = 7;
constant uint kBatchEndSixtyFourths[kDrawBatches] = {1, 2, 4, 8, 16, 32, 64};

// One thread partitions compacted survivors at doubling fractions, nearest first, into native
// four-uint draw arguments so saturation masks can separate batches.
kernel void prepareDrawArguments(const device uint* count [[buffer(0)]],
                                 device DrawArguments* draw [[buffer(1)]]) {
  uint n = count[0];
  uint start = 0;
  for (uint b = 0; b < kDrawBatches; ++b) {
    uint end = uint((ulong(n) * kBatchEndSixtyFourths[b]) / 64);
    draw[b] = DrawArguments{4, end - start, 0, start};
    start = end;
  }
}
